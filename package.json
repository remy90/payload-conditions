{
  "name": "payload-conditions-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "build": "pnpm --filter './packages/*' -r build",
    "typecheck": "pnpm --filter './packages/*' -r typecheck",
    "test": "pnpm --filter './packages/*' -r test",
    "dev": "pnpm build && pnpm --filter dev dev",
    "seed": "pnpm build && pnpm --filter dev seed",
    "dev:seed": "pnpm seed",
    "release": "pnpm build && pnpm test && pnpm -r publish --access public"
  }
}
