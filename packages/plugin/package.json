{
  "name": "@remy90/payload-conditions-plugin",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "description": "plugin for Payload CMS, which enables conditional logic for pages to display",
  "license": "MIT",
  "author": {
    "name": "Remy",
    "url": "https://github.com/remy90"
  },
  "homepage": "https://github.com/remy90/payload-conditions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remy90/payload-conditions.git",
    "directory": "packages/plugin"
  },
  "keywords": [
    "payload",
    "cms",
    "react",
    "plugin",
    "payload-plugin",
    "conditions",
    "iff",
    "ifttt",
    "prerequisite"
  ],
  "bugs": {
    "url": "https://github.com/remy90/payload-conditions/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --project tsconfig.test.json",
    "test": "pnpm build && vitest run",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "devDependencies": {
    "@payloadcms/ui": "^3.94.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "payload": "^3.94.0",
    "react": "^19.3.1",
    "typescript": "7.1.0-beta || >=7.1.0-rc <8",
    "vitest": "^5.1.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.34.9",
  "dependencies": {
    "@remy90/payload-conditions-engine": "workspace:^"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.94.0",
    "payload": "^3.94.0",
    "react": "^19.0.0"
  }
}
